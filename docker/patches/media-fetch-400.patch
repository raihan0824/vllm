+def _http_status_reason(status: int) -> str:
+    # The standard phrase, not the media host's own reason text, which a
+    # third-party server controls.
+    try:
+        return f"HTTP {status} {HTTPStatus(status).phrase}"
+    except ValueError:
+        return f"HTTP {status}"
+
+
+def _wrap_media_fetch_error(url_spec: Url, exc: Exception) -> Exception:
+    """Map a failure to download media from a URL to a client error (HTTP 400).
+
+    The URL comes from the request, so a dead or unreachable link (any HTTP
+    error status from the media host, timeouts, DNS or connection failures)
+    is the client's problem, not a server error. Called after the connection's
+    own retries are exhausted. Only the host is named in the message: media
+    URLs are often presigned and carry credentials in the query string.
+
+    Args:
+        url_spec: The parsed media URL.
+        exc: The exception raised while downloading it.
+
+    Returns:
+        A VLLMValidationError for download failures, else exc unchanged.
+    """
+    where = f"Failed to fetch media from {url_spec.host or 'URL'}"
+    if isinstance(exc, aiohttp.ClientResponseError):
+        reason = _http_status_reason(exc.status)
+    elif isinstance(exc, requests.exceptions.HTTPError):
+        response = exc.response
+        if response is None:
+            reason = "HTTP error"
+        else:
+            reason = _http_status_reason(response.status_code)
+    elif isinstance(
+        exc,
+        (
+            TimeoutError,
+            asyncio.TimeoutError,
+            aiohttp.ServerTimeoutError,
+            requests.exceptions.Timeout,
+        ),
+    ):
+        reason = "timed out"
+    elif isinstance(
+        exc, (aiohttp.ClientConnectionError, requests.exceptions.ConnectionError)
+    ):
+        reason = "could not connect (DNS or connection error)"
+    elif isinstance(exc, (aiohttp.ClientError, requests.exceptions.RequestException)):
+        reason = type(exc).__name__
+    else:
+        return exc
+    return VLLMValidationError(f"{where}: {reason}")
+
